generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName            String   @default("Sushanta Bhowmick") @map("full_name")
  displayName         String   @default("Sushanta") @map("display_name")
  headline            String?
  bioShort            String?  @map("bio_short")
  bioLong             String?  @map("bio_long")
  availabilityText    String?  @default("Available for new opportunities") @map("availability_text")
  isAvailable         Boolean? @default(true) @map("is_available")
  email               String?
  phone               String?
  location            String?
  githubUrl           String?  @map("github_url")
  linkedinUrl         String?  @map("linkedin_url")
  calendarUrl         String?  @map("calendar_url")
  yearsExperience     String?  @default("3+") @map("years_experience")
  projectsCompleted   String?  @default("25+") @map("projects_completed")
  clientSatisfaction  String?  @default("100%") @map("client_satisfaction")
  updatedAt           DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model HeroRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String
  sortOrder Int?     @default(0) @map("sort_order")
  isActive  Boolean? @default(true) @map("is_active")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("hero_roles")
}

model Resume {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filePath     String   @map("file_path")
  fileUrl      String   @map("file_url")
  fileName     String   @map("file_name")
  versionLabel String?  @map("version_label")
  isActive     Boolean? @default(false) @map("is_active")
  uploadedAt   DateTime? @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  @@map("resumes")
}

model Project {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  description   String
  imageUrl      String?  @map("image_url")
  category      String   @default("Full-Stack")
  technologies  String[] @default([])
  liveUrl       String?  @map("live_url")
  githubUrl     String?  @map("github_url")
  featured      Boolean? @default(false)
  isPublished   Boolean? @default(true) @map("is_published")
  sortOrder     Int?     @default(0) @map("sort_order")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("projects")
}

model SkillCategory {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String  @unique
  title     String
  color     String? @default("from-blue-500 to-cyan-500")
  iconKey   String? @default("Code") @map("icon_key")
  sortOrder Int?    @default(0) @map("sort_order")
  skills    Skill[]

  @@map("skill_categories")
}

model Skill {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String
  level       Int           @default(80)
  description String?       @default("")
  sortOrder   Int?          @default(0) @map("sort_order")
  isPublished Boolean?      @default(true) @map("is_published")
  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model LearningTag {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String
  sortOrder Int?   @default(0) @map("sort_order")

  @@map("learning_tags")
}

model AboutHighlight {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iconKey     String? @default("Code2") @map("icon_key")
  title       String
  description String
  sortOrder   Int?    @default(0) @map("sort_order")

  @@map("about_highlights")
}

model JourneyItem {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year        String
  title       String
  description String
  sortOrder   Int?   @default(0) @map("sort_order")

  @@map("journey_items")
}

model FunFact {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String
  iconKey   String? @default("Coffee") @map("icon_key")
  sortOrder Int?    @default(0) @map("sort_order")

  @@map("fun_facts")
}

model ContactSubmission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String
  subject   String
  message   String
  status    String?  @default("new")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_submissions")
}

model Automation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  enabled     Boolean? @default(false)
  config      Json?    @default("{}")
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  logs        AutomationLog[]

  @@map("automations")
}

model AutomationLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  automationId  String?  @map("automation_id") @db.Uuid
  status        String
  payload       Json?    @default("{}")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  automation    Automation? @relation(fields: [automationId], references: [id], onDelete: SetNull)

  @@map("automation_logs")
}

model SiteSettings {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  ogImageUrl     String?  @map("og_image_url")
  showAbout      Boolean? @default(true) @map("show_about")
  showSkills     Boolean? @default(true) @map("show_skills")
  showProjects   Boolean? @default(true) @map("show_projects")
  showContact    Boolean? @default(true) @map("show_contact")
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("site_settings")
}
